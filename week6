# ==========================================
# 1. Configuration and inputs
# ==========================================

from pathlib import Path
import numpy as np
import pandas as pd

DATA_DIR = Path
BASE_DIR = DATA_DIR / "weeks4_5_output"
OUTPUT_DIR = DATA_DIR / "week6_output"

INPUT_FILE = BASE_DIR / "sold" / "cleaned_residential.csv"

SCHOOL_FILE = (
    DATA_DIR / "DistrictAreas2425" / "DistrictAreas2425.shp"
)

required_files = [
    INPUT_FILE,
    SCHOOL_FILE,
    SCHOOL_FILE.with_suffix(".shx"),
    SCHOOL_FILE.with_suffix(".dbf"),
    SCHOOL_FILE.with_suffix(".prj"),
]

missing_files = [str(p) for p in required_files if not p.is_file()]

if missing_files:
    raise FileNotFoundError(
        "Missing input files:\n" + "\n".join(missing_files)
    )

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

df = pd.read_csv(
    INPUT_FILE,
    encoding="utf-8-sig",
    dtype={
        "ListingId": "string",
        "ListingKey": "string",
        "PostalCode": "string",
    },
    low_memory=False,
)

print("Sold input:", INPUT_FILE)
print("School district input:", SCHOOL_FILE)
print("Output folder:", OUTPUT_DIR)
print("Original rows:", len(df))
print("Original columns:", len(df.columns))



# ==========================================
# 2. Validate required columns
# ==========================================

required = [
    "ClosePrice",
    "OriginalListPrice",
    "LivingArea",
    "DaysOnMarket",
    "CloseDate",
    "PurchaseContractDate",
    "ListingContractDate"
]

missing = [c for c in required if c not in df.columns]

if missing:
    raise KeyError(f"Missing required columns: {missing}")


# ==========================================
# 3. Convert numeric columns
# ==========================================

numeric_cols = [
    "ClosePrice",
    "OriginalListPrice",
    "LivingArea",
    "DaysOnMarket"
]

for col in numeric_cols:
    values = (
        df[col]
        .astype("string")
        .str.replace(r"[$,]", "", regex=True)
        .str.strip()
    )

    df[col] = pd.to_numeric(values, errors="coerce")


# ==========================================
# 4. Price Ratio
# ClosePrice / OriginalListPrice
# ==========================================

valid_original_price = df["OriginalListPrice"].where(
    df["OriginalListPrice"] > 0
)

df["PriceRatio"] = (
    df["ClosePrice"] / valid_original_price
)


# ==========================================
# 5. Price Per Square Foot
# ClosePrice / LivingArea
# ==========================================

valid_area = df["LivingArea"].where(
    df["LivingArea"] > 0
)

df["PricePerSqFt"] = (
    df["ClosePrice"] / valid_area
)


# ==========================================
# 6. Close to Original List Ratio
# ==========================================

df["CloseToOriginalListRatio"] = (
    df["ClosePrice"] / valid_original_price
)


# ==========================================
# 7. Parse date columns
# ==========================================

date_cols = [
    "CloseDate",
    "PurchaseContractDate",
    "ListingContractDate"
]

for col in date_cols:
    df[col] = pd.to_datetime(
        df[col],
        errors="coerce",
        format="mixed",
        utc=True
    )


# ==========================================
# 8. Year, Month, YrMo
# ==========================================

df["Year"] = df["CloseDate"].dt.year.astype("Int64")

df["Month"] = df["CloseDate"].dt.month.astype("Int64")

df["YrMo"] = df["CloseDate"].dt.strftime("%Y-%m")


# ==========================================
# 9. Listing to Contract Days
# ==========================================

df["ListingToContractDays"] = (
    df["PurchaseContractDate"]
    - df["ListingContractDate"]
).dt.days


# ==========================================
# 10. Contract to Close Days
# ==========================================

df["ContractToCloseDays"] = (
    df["CloseDate"]
    - df["PurchaseContractDate"]
).dt.days


# ==========================================
# 11. Days on Market
# Retain original DaysOnMarket field
# ==========================================

# DaysOnMarket was converted to numeric in step 3.
# No additional calculation is required.


# ==========================================
# 12. Validate engineered features
# ==========================================

features = [
    "PriceRatio",
    "PricePerSqFt",
    "DaysOnMarket",
    "Year",
    "Month",
    "YrMo",
    "CloseToOriginalListRatio",
    "ListingToContractDays",
    "ContractToCloseDays"
]

quality = pd.DataFrame({
    "Feature": features,
    "NonNullCount": [
        df[c].notna().sum() for c in features
    ],
    "NullCount": [
        df[c].isna().sum() for c in features
    ],
    "NullPercentage": [
        round(df[c].isna().mean() * 100, 2)
        for c in features
    ]
})

quality.to_csv(
    OUTPUT_DIR / "feature_quality_report.csv",
    index=False
)

print("\nFEATURE QUALITY REPORT")
print(quality.to_string(index=False))

print("\nNegative date intervals:")
for col in [
    "ListingToContractDays",
    "ContractToCloseDays"
]:
    print(col, (df[col] < 0).sum())


# ==========================================
# 13. Segmented Market Analysis
# ==========================================

def segment_summary(data, group_col):

    if group_col not in data.columns:
        print(f"Skipping unavailable field: {group_col}")
        return

    summary = data.groupby(
        group_col, dropna=False
    ).agg(
        TransactionCount=("ClosePrice", "size"),
        MedianClosePrice=("ClosePrice", "median"),
        MeanClosePrice=("ClosePrice", "mean"),
        MedianPricePerSqFt=("PricePerSqFt", "median"),
        MeanPriceRatio=("PriceRatio", "mean"),
        MedianDaysOnMarket=("DaysOnMarket", "median"),
        MedianListingToContractDays=(
            "ListingToContractDays", "median"
        ),
        MedianContractToCloseDays=(
            "ContractToCloseDays", "median"
        )
    ).reset_index()

    # Counts with valid close price for clarity
    valid_counts = (
        data.groupby(group_col, dropna=False)["ClosePrice"]
        .count()
        .reset_index(name="ValidClosePriceCount")
    )

    summary = summary.merge(
        valid_counts,
        on=group_col,
        how="left",
        validate="one_to_one"
    )

    summary = summary.sort_values(
        "TransactionCount",
        ascending=False
    )

    filename = f"summary_by_{group_col}.csv"

    summary.to_csv(
        OUTPUT_DIR / filename,
        index=False
    )

    print(f"\nSEGMENT SUMMARY: {group_col}")
    print(summary.head(10).to_string(index=False))


# Group by all requested dimensions
segment_columns = [
    "PropertyType",
    "PropertySubType",
    "CountyOrParish",
    "MLSAreaMajor",
    "ListOfficeName",
    "BuyerOfficeName"
]

for col in segment_columns:
    segment_summary(df, col)


