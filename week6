# ==========================================
# Week 6 - School District Spatial Join
# ==========================================

import pandas as pd
import geopandas as gpd
from pathlib import Path

DATA_DIR = Path("/Users/yuki/csv")
OUTPUT_DIR = DATA_DIR / "week6_output"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

SCHOOL_FILE = (
    DATA_DIR / "DistrictAreas2425" / "DistrictAreas2425.shp"
)

# df is the engineered Sold dataset from earlier steps.
# If df no longer exists, reload the saved dataset.

if "df" not in globals():
    input_file = OUTPUT_DIR / "week6_sold_engineered.csv"
    df = pd.read_csv(input_file, low_memory=False)

original_rows = len(df)

# 1. Load school district boundaries
districts = gpd.read_file(SCHOOL_FILE)

districts = districts[
    ["CDSCode", "DistrictNa", "DistrictTy", "geometry"]
].copy()

# 2. Convert coordinates to numeric
for col in ["Latitude", "Longitude"]:
    df[col] = pd.to_numeric(df[col], errors="coerce")

valid_coords = (
    df["Latitude"].between(-90, 90)
    & df["Longitude"].between(-180, 180)
)

print("Total properties:", original_rows)
print("Valid coordinates:", valid_coords.sum())

# 3. Create geographic points
points = gpd.GeoDataFrame(
    df.loc[valid_coords, ["Latitude", "Longitude"]].copy(),
    geometry=gpd.points_from_xy(
        df.loc[valid_coords, "Longitude"],
        df.loc[valid_coords, "Latitude"]
    ),
    crs="EPSG:4326"
)

# Preserve exact original row identity
points["_row_id"] = points.index

# 4. Convert district boundaries to same CRS
districts = districts.to_crs(points.crs)

# 5. Spatial join
matched = gpd.sjoin(
    points[["_row_id", "geometry"]],
    districts,
    how="left",
    predicate="intersects"
)

# 6. Aggregate matches by original row
# Some properties may intersect more than one district
# (for example, elementary and high school districts).

def combine_unique(values):
    unique = sorted(set(values.dropna().astype(str)))
    return "; ".join(unique) if unique else pd.NA

school_results = matched.groupby("_row_id").agg(
    SchoolDistrict=("DistrictNa", combine_unique),
    SchoolDistrictType=("DistrictTy", combine_unique),
    SchoolDistrictCode=("CDSCode", combine_unique)
)

# 7. Add district columns without changing row count
for col in [
    "SchoolDistrict",
    "SchoolDistrictType",
    "SchoolDistrictCode"
]:
    df[col] = df.index.map(school_results[col])

# 8. Validate results
assert len(df) == original_rows, (
    "ERROR: Property row count changed"
)

matched_count = df["SchoolDistrict"].notna().sum()

print("\n===== SCHOOL DISTRICT VALIDATION =====")
print("Total properties:", len(df))
print("Matched properties:", matched_count)
print("Unmatched properties:", len(df) - matched_count)
print("Match rate:", round(matched_count / len(df) * 100, 2), "%")

# 9. Preview results
preview_cols = [
    "Latitude",
    "Longitude",
    "SchoolDistrict",
    "SchoolDistrictType",
    "SchoolDistrictCode"
]

display(df[preview_cols].head(10))

# 10. Save complete dataset
output_file = OUTPUT_DIR / "week6_sold_engineered.csv"

df.to_csv(output_file, index=False)

print("\nSaved:", output_file)


